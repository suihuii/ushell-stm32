{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32: Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "STM32: Flash",
            "type": "shell",
            "command": "/opt/st/stm32cubeclt_1.21.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI",
            "args": [
                "-c",
                "port=SWD",
                "-d",
                "${workspaceFolder}/build/Debug/ushell-stm32.elf",
                "-v",
                "-rst"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "STM32: Build + Flash",
            "dependsOrder": "sequence",
            "dependsOn": [
                "STM32: Build Debug",
                "STM32: Flash"
            ],
            "problemMatcher": []
        }
    ]
}